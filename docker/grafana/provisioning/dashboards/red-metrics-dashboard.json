      "title": "🛡️ Latência de Avaliação Antifraude",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum(rate(antifraud_evaluation_duration_seconds_bucket[1m])) by (le))",
          "legendFormat": "p95 Antifraud Evaluation",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(antifraud_evaluation_duration_seconds_sum[1m]) / rate(antifraud_evaluation_duration_seconds_count[1m])",
          "legendFormat": "Avg Antifraud Evaluation",
          "refId": "B"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
